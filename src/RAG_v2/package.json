{
  "name": "rag-student-assistant",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend/chat-companion",
    "mobile"
  ],
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=chat-companion",
    "dev:mobile": "turbo run dev --filter=mobile",
