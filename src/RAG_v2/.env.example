# ═══════════════════════════════════════════════════════════════════════════════
# RAG v2 — Environment Configuration Template
# Copy this to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════
#
# ┌─────────────────────────────────────────────────────────┐
# │              PROVIDER STRATEGY                          │
# │  DEEPSEEK  → answer generation                          │
# │  GEMINI    → reflection, synthesis                       │
# │  LM_STUDIO → agent tool-calling only (local Qwen)       │
# └─────────────────────────────────────────────────────────┘

# ─── Provider Selectors ────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek            # ✅ deepseek | gemini | openai | lm_studio | ollama
EMBEDDING_PROVIDER=ensemble      # ensemble | bge_m3 | e5
RERANKER_PROVIDER=bge            # bge | cohere | none

# ─── API Keys ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here   # only if using DeepSeek
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here       # only if using OpenAI
TAVILY_API_KEY=your-tavily-api-key-here       # for web search fallback
LLM_API_KEY=                                  # leave blank — resolved per provider

# ─── LM Studio (Agent tool-calling) ───────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1

# ─── Agent (LangGraph ReAct) ───────────────────────────────────────────────────
# Qwen handles tool-calling (planning) — fast local inference, low quality OK
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=3
AGENT_MODEL=qwen2.5-7b-instruct
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=1200
AGENT_TOOL_RESULT_LIMIT=3000
AGENT_SEARCH_RESULT_COUNT=4
AGENT_SEARCH_RESULT_CHAR_LIMIT=700

# Gemini handles final answer synthesis — quality-critical, user-facing
AGENT_SYNTHESIS_PROVIDER=gemini              # ✅ gemini | lm_studio | ollama | ""
AGENT_SYNTHESIS_MODEL=gemini-3.1-flash-lite       # gemini-3.1-flash-lite | gemini-3.1-flash-lite
AGENT_SYNTHESIS_TEMPERATURE=0.2
AGENT_SYNTHESIS_MAX_TOKENS=2000

# ─── Chat Model (Answer Generation) ───────────────────────────────────────────
# ✅ DeepSeek for final answer — most important quality point in the pipeline
CHAT_MODEL=deepseek-v4-flash            # deepseek-v4-flash | gemini-3.1-flash-lite
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=1024

# ─── Reflection (Query Rewriting) ─────────────────────────────────────────────
# ✅ Gemini for query rewriting — quality-critical for retrieval accuracy
REFLECTION_ENABLED=true
REFLECTION_PROVIDER=gemini         # ✅ gemini | lm_studio | ollama | openai
REFLECTION_MODEL=gemini-3.1-flash-lite  # fast + quality rewrite
REFLECTION_TEMPERATURE=0.0
REFLECTION_MAX_TOKENS=256

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ─── Exam schedule (lịch thi) ────────────────────────────────────────────────────
# Structured PDF/Excel exam-timetable ingestion + lookup. The column map and the
# Kíp→start-time fallback are code defaults (config/settings.py); the PDF banner's
# own Kíp legend takes precedence at ingest. Only scalars are overridable here.
EXAM_SCHEDULE_ES_INDEX=exam_schedules
EXAM_SCHEDULE_SEARCH_TOP_K=20
EXAM_SCHEDULE_TWO_DIGIT_YEAR_PIVOT=2000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rag_chatbot
MONGODB_ENABLED=true

# ─── Notifications ─────────────────────────────────────────────────────────────
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_TIMEOUT_SECONDS=5

# ─── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=7
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
VECTOR_POOL_K=15
KEYWORD_POOL_K=15
RAW_CANDIDATE_MULTIPLIER=4.0
RAW_CANDIDATE_MIN=20
VECTOR_WEIGHT=0.8
KEYWORD_WEIGHT=0.2
CONTEXT_DOC_CHAR_LIMIT=2000
CONTEXT_TOTAL_CHAR_BUDGET=12000
CONTEXT_LIST_TOTAL_CHAR_BUDGET=24000

# ─── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=7
RERANKER_SCORE_THRESHOLD=-1.0
RERANKER_TABLE_SCORE_THRESHOLD=-1.0
RERANKER_MIN_TOP_K=7

# ─── Embedding Models ──────────────────────────────────────────────────────────
BGE_M3_MODEL=BAAI/bge-m3
E5_MODEL=intfloat/multilingual-e5-large

# ─── Router ────────────────────────────────────────────────────────────────────
ROUTER_MODE=classifier            # classifier | llm

# ─── Collection-aware Routing ──────────────────────────────────────────────────
DOMAIN_ROUTING_ENABLED=true
DOMAIN_CONFIDENCE_THRESHOLD=0.65

# ─── Evaluation & Fallback ─────────────────────────────────────────────────────
# Keep direct self_eval OFF by default. Enable Tavily fallback separately below.
SELF_EVAL_ENABLED=false
# BGE reranker returns raw logits, not probabilities; 100 disables unsafe skip.
SELF_EVAL_MIN_TOP_SCORE=100.0
TAVILY_FALLBACK_ENABLED=false
TAVILY_SEARCH_DEPTH=basic                  # basic (1 credit) | advanced (2 credits)
TAVILY_MAX_RESULTS=3                       # results per Tavily search
WEB_FALLBACK_DYNAMIC_COLLECTIONS=["kehoach"]
WEB_FALLBACK_ON_DYNAMIC=false              # pre-fetch web context for time-sensitive queries
WEB_FALLBACK_ON_NO_INFO=false
TAVILY_CACHE_TTL_SECONDS=3600              # in-process Tavily result cache TTL
TAVILY_CACHE_MAXSIZE=200                   # max cached Tavily search entries

# ─── Authentication ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-long-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── Microsoft OAuth 2.0 (optional) ───────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_BASE_URL=http://localhost:8080

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false                    # Master switch — set true to activate Redis
USE_REDIS_SESSION=false                # Phase 1: session migration to Redis
USE_REDIS_CACHE=false                  # Phase 2: LLM response cache
USE_REDIS_HISTORY=false                # Phase 2: conversation history cache

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=20                      # max requests per minute per user
RATE_LIMIT_RPD=200                     # max requests per day per user
RATE_LIMIT_ALERT_THRESHOLD=0.8         # alert when user reaches 80% of limit

# ─── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Docker / Production overrides ─────────────────────────────────────────────
# Khi chạy bằng docker-compose, thay localhost → tên service:
#   QDRANT_HOST=qdrant
#   ELASTICSEARCH_HOST=elasticsearch
#   MONGODB_URI=mongodb://mongodb:27017
# docker-compose.yml tự set các biến này qua environment:, không cần sửa file này.
