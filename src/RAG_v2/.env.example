# ─── Provider Selectors ────────────────────────────────────────────────────────
LLM_PROVIDER=gemini           # gemini | openai | azure | ollama
EMBEDDING_PROVIDER=ensemble   # ensemble | bge_m3 | e5
RERANKER_PROVIDER=bge         # bge | cohere | none

# ─── API Keys ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
LLM_API_KEY=                  # resolved by factory; leave blank to use provider-specific key

# ─── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=

# ─── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rag_chatbot

# ─── Chat Model ────────────────────────────────────────────────────────────────
CHAT_MODEL=gemini-2.5-flash
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=1024 * 5

# ─── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
VECTOR_POOL_K=15
KEYWORD_POOL_K=15
VECTOR_WEIGHT=0.8
KEYWORD_WEIGHT=0.2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# ─── Router ────────────────────────────────────────────────────────────────────
ROUTER_MODE=classifier

# ─── Evaluation & Fallback ─────────────────────────────────────────────────────
SELF_EVAL_ENABLED=false
TAVILY_FALLBACK_ENABLED=false

# ─── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
