# ─────────────────────────────────────────────────────────────────────────────
# Frontend Dockerfile — React/Vite (chat-companion)
# Multi-stage: build → serve with nginx
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY src/RAG_v2/frontend/chat-companion/package*.json ./
RUN npm ci

COPY src/RAG_v2/frontend/chat-companion/ ./

# VITE_API_URL passed at build time (or set via ARG)
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:alpine

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config: forward /api/* to backend, serve SPA for everything else
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
